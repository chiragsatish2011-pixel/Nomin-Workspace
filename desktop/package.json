{
  "name": "nomin-workspace",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder -w -l"
  },
  "build": {
    "appId": "com.nomin.workspace",
    "productName": "Nomin Workspace",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}
