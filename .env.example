# Nomin Workspace — the only three variables the app needs.
# Copy to .env.local for local development, or set them in your host's
# environment-variable dashboard for a deploy.

# Pooled Postgres URL (Neon: use the -pooler host, never a direct connection).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Signs JWT sessions. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Public app URL used for auth callbacks and redirects.
NEXTAUTH_URL="http://localhost:3000"
